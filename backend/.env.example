# NyayaAI Environment Configurations Template

PROJECT_NAME="NyayaAI"
API_V1_STR="/api/v1"
ENVIRONMENT="local"

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="nyaya_ai"

# Qdrant Vector DB Configuration
